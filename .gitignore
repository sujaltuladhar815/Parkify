# ==========================================
# Parkify - Git Ignore
# ==========================================

# ---------- Python ----------
__pycache__/
*.py[cod]
*.pyo
*.pyd
.venv/
venv/
env/
ENV/
.python-version
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ---------- Node.js ----------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ---------- Environment / Secrets ----------
.env
.env.*
!.env.example

# Local config files
*.local

# ---------- IDE / Editor ----------
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# ---------- YOLO / ML Training Outputs ----------
runs/
**/runs/
weights/
**/weights/
*.pt
*.onnx
*.pth
*.ckpt

# ---------- Debug / Temporary Computer Vision Files ----------
debug_crops/
**/debug_crops/

# Camera frames / generated images
**/frame.jpg
**/frame_result.jpg
**/latest_frame.jpg
**/test_frame.jpg

# ---------- Logs ----------
*.log
**/*.log

# ---------- Generated OCR / Detection Output ----------
output/
**/output/
*.csv

# Generated Excel / runtime data
*.xlsx
*.xls

# ---------- Temporary / Cache Files ----------
tmp/
temp/
cache/
*.tmp
*.bak

# ---------- Coverage / Build ----------
.coverage
htmlcov/
dist/
build/

# ---------- Local Database Files ----------
*.sqlite
*.sqlite3
*.db

# ---------- OS-specific ----------
Desktop.ini
$RECYCLE.BIN/

# ---------- Important files intentionally NOT ignored ----------
# package.json
# package-lock.json
# requirements.txt